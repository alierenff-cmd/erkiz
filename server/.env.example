# Bu dosyayi .env olarak kopyalayin ve doldurun. .env ASLA versiyon kontrolune girmez.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erkiz_app
DB_PASSWORD=degistirin
DB_NAME=erkiz_takip

# openssl rand -hex 32  ile uretin
JWT_SECRET=
SESSION_SECRET=
TC_ENCRYPTION_KEY=

ADMIN_USERNAME=admin
# npm run hash-password ile uretin
ADMIN_PASSWORD_HASH=

# SAP REST API Entegrasyonu (isteğe bağlı, SAP dış sistem erişimi için)
SAP_API_KEY=

# SAP AL11 Uygulama Dizin Yolu (Ortak Ağ / SAP Sunucu Klasörü)
SAP_AL11_DIR=C:\sap_al11_export
