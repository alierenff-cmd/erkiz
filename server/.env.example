# ==============================================================================
# Erkiz İşçi Takip Sistemi - Örnek Ortam Değişkenleri (.env.example)
# ==============================================================================

PORT=3000

# Veritabanı Yapılandırması (Yerel MySQL veya AWS RDS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erkiz_app
DB_PASSWORD=buraya_guclu_bir_veritabani_sifresi_yazin
DB_NAME=erkiz_takip

# Güvenlik & Token Anahtarları (En az 32 karakter rastgele hex dize)
JWT_SECRET=ornek_openssl_rand_hex_32_anahtari
SESSION_SECRET=ornek_openssl_rand_hex_32_anahtari
TC_ENCRYPTION_KEY=ornek_openssl_rand_hex_32_anahtari

# Yönetici Giriş Bilgileri
ADMIN_USERNAME=admin
# Şifre hash'ini 'npm run hash-password "yeni_sifreniz"' ile oluşturabilirsiniz:
ADMIN_PASSWORD_HASH=scrypt$32768$8$1$ornek_hash_degeri==
# Ekstra Güvenlik PIN Kodu (3-Faktörlü Giriş)
ADMIN_SECURITY_PIN=123456

# SAP AL11 Entegrasyon Dizin Yolu (Linux: /var/data/sap_al11_export, Windows: C:\sap_al11_export)
SAP_AL11_DIR=/var/data/sap_al11_export
