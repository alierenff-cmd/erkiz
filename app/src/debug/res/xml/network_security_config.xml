<?xml version="1.0" encoding="utf-8"?>
<!--
    SADECE DEBUG APK: yerel agdaki test sunucusuna (http://<ip>:3000) erisim icin
    sifresiz HTTP'ye izin verir. Release APK bu dosyayi icermez.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
