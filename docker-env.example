# docker-compose.yml icin ornek. Bu dosyayi ".env" adiyla kopyalayip degerleri doldurun.
# Rastgele anahtar uretmek icin: openssl rand -hex 32
# Admin sifre hash'i icin:       cd server && npm run hash-password "sifreniz"

MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

JWT_SECRET=
SESSION_SECRET=
TC_ENCRYPTION_KEY=

ADMIN_USERNAME=admin
# Hash icindeki $ isaretleri sorun cikarirsa degeri tek tirnak icine alin: ADMIN_PASSWORD_HASH='scrypt$...'
ADMIN_PASSWORD_HASH=
ADMIN_SECURITY_PIN=

ALLOWED_ORIGINS=
